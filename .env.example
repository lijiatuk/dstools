# --- DeepSeek (required for deep_research; the LLM brain) ---
# Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek-V4 models (deepseek-chat/deepseek-reasoner are deprecated 2026-07-24).
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
# V4 thinking mode for hard planning/synthesis steps: auto | on | off
DEEPSEEK_THINKING=auto
DEEPSEEK_REASONING_EFFORT=high

# --- Vision provider (required for analyze_image; DeepSeek-V4 is text-only) ---
# Any OpenAI-compatible multimodal endpoint. Examples:
#   OpenAI:        https://api.openai.com/v1                 model: gpt-4o
#   Qwen-VL:       https://dashscope.aliyuncs.com/compatible-mode/v1  model: qwen-vl-max
#   GLM-4V:        https://open.bigmodel.cn/api/paas/v4      model: glm-4v
#   Local Ollama:  http://localhost:11434/v1                  model: qwen2.5-vl  (no key)
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# --- Web search (deep_research retrieval) ---
# duckduckgo is keyless (default); brave/tavily need a key and are more reliable.
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
BRAVE_API_KEY=
# Retries with backoff when the keyless DDG endpoint rate-limits.
SEARCH_RETRY_ATTEMPTS=3

# --- Deep research tuning ---
RESEARCH_BREADTH=3
RESEARCH_DEPTH=2
RESEARCH_MAX_SOURCES=8
RESEARCH_FETCH_TIMEOUT=20
# Per-step model overrides (empty = flash for plan/refine/rerank, pro for synth).
# Set all to deepseek-v4-flash for the cheapest runs.
RESEARCH_PLAN_MODEL=
RESEARCH_REFINE_MODEL=
RESEARCH_RERANK_MODEL=
RESEARCH_SYNTH_MODEL=

# --- Server / misc ---
LOG_LEVEL=INFO
# Transport is normally chosen on the CLI; this is a fallback default.
MCP_TRANSPORT=stdio
